# Postgres (used by docker-compose; not by SvelteKit at runtime in v1)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=geosentinel

# SvelteKit reads these. PUBLIC_ vars are exposed to the browser.
# For host-side dev (pnpm dev). The `web` container in docker-compose overrides this with @db:5432.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/geosentinel
PUBLIC_MARTIN_URL=http://localhost:3010
PUBLIC_TITILER_URL=http://localhost:8000
